<!-- ================================================================
     灵犀手 V2 (Lingxi Hand V2) - 竖直姿态 (Vertical)
     基于硬件 URDF (qbr.urdf) + hand_change.md 真实参数
     坐标系：URDF 原始坐标 (X=侧向, Y=沿手指, Z=掌深度)
     挂载旋转 euler="1.5708 0 1.5708"：URDF_Y→world_-X (手指竖直)
     每指 2 段 (近端+远端)，拇指 3 段，6 通道直接关节驱动
     ================================================================ -->
<mujoco model="Lingxi_Hand_V2_Right">
  <compiler angle="radian" meshdir="/home/ll/SRTP/Aero-Hand/handinformation/URDF/右/qbr/meshes/"/>

  <option timestep="0.01" integrator="Euler" iterations="12" ls_iterations="16">
    <flag eulerdamp="disable"/>
  </option>

  <custom>
    <numeric data="80" name="max_contact_points"/>
    <numeric data="50" name="max_geom_pairs"/>
  </custom>

  <asset>
    <material name="black" rgba="0.2 0.2 0.2 1"/>
    <material name="gray" rgba="0.5 0.5 0.5 1"/>
    <material name="white" rgba="0.529 0.549 0.549 1"/>
    <material name="rubber" rgba="0.3 0.3 0.3 1"/>

    <!-- V2 STL 网格 (v2_base_link.STL avoids name collision with V1 menagerie assets) -->
    <mesh name="v2_palm" file="v2_base_link.STL"/>
    <mesh name="v2_thumb_base" file="link1.STL"/>
    <mesh name="v2_thumb_mid" file="link2.STL"/>
    <mesh name="v2_thumb_tip" file="link3.STL"/>
    <mesh name="v2_index_proximal" file="link4.STL"/>
    <mesh name="v2_index_distal" file="link5.STL"/>
    <mesh name="v2_middle_proximal" file="link6.STL"/>
    <mesh name="v2_middle_distal" file="link7.STL"/>
    <mesh name="v2_ring_proximal" file="link8.STL"/>
    <mesh name="v2_ring_distal" file="link9.STL"/>
    <mesh name="v2_pinky_proximal" file="link10.STL"/>
    <mesh name="v2_pinky_distal" file="link11.STL"/>
  </asset>

  <default>
    <default class="v2_hand">
      <!-- 碰撞默认：friction=1.5, 柔性接触 -->
      <geom group="3" friction="1.5" solref="0.01 1.2" solimp="0.95 0.995 0.0005"/>
      <!-- 默认 site 隐藏到 group 4，viewer 中不显示触觉传感器小球 -->
      <site group="4"/>
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0" density="0" material="white"/>
      </default>

      <!-- 关节物理默认 -->
      <!-- armature = rotor_inertia * gear_ratio^2 = 0.371e-7 * 205^2 -->
      <joint damping="0.02" armature="0.001559127" frictionloss="0.02"/>
      <position kp="3.0"/>

      <!-- ========== 关节范围 (V2 硬件实测) ========== -->
      <!-- MCP (根→近端): 80° = 1.3963 rad -->
      <default class="mcp">
        <joint range="0 1.3963" damping="0.1"/>
        <position ctrlrange="0 1.40"/>
      </default>
      <!-- PIP (被动耦合): 74° = 1.2915 rad -->
      <default class="pip">
        <joint range="0 1.2915" damping="0.05"/>
      </default>
      <!-- 拇指 CMC 外展: 79° = 1.3788 rad -->
      <default class="thumb_cmc">
        <joint range="0 1.3788" damping="0.1"/>
        <position ctrlrange="0 1.38"/>
      </default>
      <!-- 拇指 CMC 弯曲 (被动): 30° = 0.5236 rad -->
      <default class="thumb_flex">
        <joint range="0 0.5236" damping="0.05"/>
      </default>
      <!-- 拇指 MCP/IP: 45° = 0.7854 rad -->
      <default class="thumb_mcp">
        <joint range="0 0.7854" damping="0.05"/>
        <position ctrlrange="0 0.79"/>
      </default>
    </default>
  </default>

  <!-- 自碰撞排除 -->
  <contact>
    <exclude body1="palm" body2="right_index_proximal"/>
    <exclude body1="palm" body2="right_middle_proximal"/>
    <exclude body1="palm" body2="right_ring_proximal"/>
    <exclude body1="palm" body2="right_pinky_proximal"/>
    <exclude body1="palm" body2="right_thumb_base"/>
    <exclude body1="palm" body2="right_thumb_mid"/>
    <exclude body1="palm" body2="right_ring_distal"/>
    <exclude body1="palm" body2="right_pinky_distal"/>
    <exclude body1="v2_mount" body2="right_index_proximal"/>
    <exclude body1="v2_mount" body2="right_middle_proximal"/>
    <exclude body1="v2_mount" body2="right_ring_proximal"/>
    <exclude body1="v2_mount" body2="right_pinky_proximal"/>
    <exclude body1="v2_mount" body2="right_thumb_base"/>
    <exclude body1="right_index_proximal" body2="right_index_distal"/>
    <exclude body1="right_middle_proximal" body2="right_middle_distal"/>
    <exclude body1="right_ring_proximal" body2="right_ring_distal"/>
    <exclude body1="right_pinky_proximal" body2="right_pinky_distal"/>
    <exclude body1="right_thumb_base" body2="right_thumb_mid"/>
    <exclude body1="right_thumb_mid" body2="right_thumb_tip"/>
    <!-- 相邻手指互排除 (碰撞盒放大后避免不必要碰撞对) -->
    <exclude body1="right_index_proximal" body2="right_middle_proximal"/>
    <exclude body1="right_index_distal" body2="right_middle_distal"/>
    <exclude body1="right_middle_proximal" body2="right_ring_proximal"/>
    <exclude body1="right_middle_distal" body2="right_ring_distal"/>
    <exclude body1="right_ring_proximal" body2="right_pinky_proximal"/>
    <exclude body1="right_ring_distal" body2="right_pinky_distal"/>
    <exclude body1="right_index_proximal" body2="right_middle_distal"/>
    <exclude body1="right_middle_proximal" body2="right_ring_distal"/>
    <exclude body1="right_ring_proximal" body2="right_pinky_distal"/>
    <exclude body1="right_middle_proximal" body2="right_index_distal"/>
    <exclude body1="right_ring_proximal" body2="right_middle_distal"/>
    <exclude body1="right_pinky_proximal" body2="right_ring_distal"/>
  </contact>

