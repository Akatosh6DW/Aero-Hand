  <!-- ==================== 等式约束 (被动关节耦合) ==================== -->
  <equality>
    <!-- 四指 PIP 被动耦合到 MCP: pip ≈ 0.925 * mcp
         当 MCP=80° 时, PIP=74° (匹配硬件) -->
    <joint joint1="right_index_pip" joint2="right_index_mcp"
           polycoef="0 0.925 0 0 0" solref="0.005 1" solimp="0.95 0.99 0.001"/>
    <joint joint1="right_middle_pip" joint2="right_middle_mcp"
           polycoef="0 0.925 0 0 0" solref="0.005 1" solimp="0.95 0.99 0.001"/>
    <joint joint1="right_ring_pip" joint2="right_ring_mcp"
           polycoef="0 0.925 0 0 0" solref="0.005 1" solimp="0.95 0.99 0.001"/>
    <joint joint1="right_pinky_pip" joint2="right_pinky_mcp"
           polycoef="0 0.925 0 0 0" solref="0.005 1" solimp="0.95 0.99 0.001"/>
    <!-- 拇指 CMC flex 被动耦合到 CMC abd: flex ≈ 0.16 * abd
         R86: 从0.38降到0.16 — 指尖距离从29.6mm降到10.8mm -->
    <joint joint1="right_thumb_cmc_flex" joint2="right_thumb_cmc_abd"
           polycoef="0 0.16 0 0 0" solref="0.005 1" solimp="0.95 0.99 0.001"/>
  </equality>

