<mujoco>
  <!-- 当前 can 场景使用“易拉罐/小圆柱代理”。
       2026-04-23 用户将待抓取物改为更小的圆柱：
         - 直径 40 mm
         - 高度 60 mm
       这一版优先服务于场景检查和初始抓取位姿调节，因此：
         - 保留 cube/cube_freejoint 兼容命名，避免现有工具链失效；
         - 用更软的接触参数近似“易变形、不能大力捏”的约束；
         - 质量仍先按轻质近似 30 g 建模，后续按真实目标再收敛。 -->
  <default>
    <default class="can_shell">
      <geom
          friction="1.20 0.025 0.005"
          conaffinity="7"
          condim="4"
          solref="0.030 1.0"
          solimp="0.82 0.90 0.003"
      />
    </default>
  </default>

  <asset>
    <material name="can_shell" rgba="0.78 0.80 0.84 0.96" specular="0.45" shininess="0.30"/>
    <material name="can_label" rgba="0.88 0.18 0.22 1.0" specular="0.15" shininess="0.10"/>
    <material name="can_lid" rgba="0.93 0.94 0.96 1.0" specular="0.35" shininess="0.22"/>
  </asset>

  <worldbody>
    <!-- 横放圆柱：总长 0.06 m，直径 0.04 m。 -->
    <body name="cube" pos="0.008041 -0.040830 0.132128" quat="0.707715 -0.007412 0.706458 0.000577" childclass="can_shell">
      <freejoint name="cube_freejoint"/>

      <!-- 主碰撞体：
           MJX 当前不支持 cylinder-vs-box 接触，因此真实物理仍用同包络尺寸的
           capsule 近似；圆柱外观由下面的 visual geom 提供。 -->
      <geom
          name="cube"
          type="capsule"
          fromto="0 0 -0.010 0 0 0.010"
          size="0.020"
          mass="0.030"
          group="3"
          material="can_shell"
      />

      <geom
          name="can_body_visual"
          type="cylinder"
          size="0.020 0.030"
          pos="0 0 0"
          mass="0"
          density="0"
          group="1"
          material="can_shell"
          contype="0"
          conaffinity="0"
      />

      <!-- 标签带：只做视觉辅助，不参与碰撞。 -->
      <geom
          name="can_label_band"
          type="cylinder"
          size="0.0206 0.012"
          pos="0 0 0"
          mass="0"
          density="0"
          group="1"
          material="can_label"
          contype="0"
          conaffinity="0"
      />

      <!-- 保留简化顶盖/底盖，便于视觉识别。 -->
      <geom
          name="can_top_lid"
          type="cylinder"
          size="0.019 0.0015"
          pos="0 0 0.0285"
          mass="0"
          density="0"
          group="1"
          material="can_lid"
          contype="0"
          conaffinity="0"
      />
      <geom
          name="can_bottom_lid"
          type="cylinder"
          size="0.019 0.0015"
          pos="0 0 -0.0285"
          mass="0"
          density="0"
          group="1"
          material="can_lid"
          contype="0"
          conaffinity="0"
      />

      <site name="cube_center" pos="0 0 0" size="0.006" rgba="0 0.8 0 0.7" group="4"/>
      <site name="can_center" pos="0 0 0" size="0.006" rgba="0 0.8 0 0.7" group="4"/>
      <site
          name="can_grasp_band"
          pos="0 0 0"
          size="0.024 0.024 0.022"
          type="ellipsoid"
          rgba="1 0 0 0.10"
          group="4"
      />
    </body>
  </worldbody>
</mujoco>
